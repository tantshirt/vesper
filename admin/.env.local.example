# Copy to .env.local and fill in. Names only — never commit real values.

# Convex — the SAME deployment the consumer app (app/) uses.
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud

# WorkOS AuthKit (from the WorkOS dashboard). The admin app authenticates staff via WorkOS SSO.
WORKOS_API_KEY=<your-workos-api-key>
WORKOS_CLIENT_ID=<your-workos-client-id>
# A 32+ character secret used to encrypt the session cookie (e.g. `openssl rand -base64 32`).
WORKOS_COOKIE_PASSWORD=<32-plus-char-random-secret>
# The redirect/callback URI registered in the WorkOS dashboard for this app.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3001/callback

# ---- Also set in the CONVEX dashboard (Settings → Environment Variables) ----
# WORKOS_CLIENT_ID=<your-workos-client-id>   # enables the WorkOS provider in convex/auth.config.ts
