{
  "name": "vesper-app",
  "version": "0.1.0",
  "private": true,
  "description": "Vesper consumer app — E1.1 reactive backbone (Next.js + Convex + Privy).",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
