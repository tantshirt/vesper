    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.4",
    "convex": "^1.17.0",
    "next": "^16.2.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^4.0.0",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "convex-test": "^0.0.35",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "elliptic": "^6.6.1",
