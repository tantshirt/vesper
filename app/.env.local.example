# Copy to .env.local and fill in.

# Convex (from `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud

# Privy (from Privy dashboard → App settings)
NEXT_PUBLIC_PRIVY_APP_ID=<your-privy-app-id>

# ---- Set in the CONVEX dashboard (Settings → Environment Variables), NOT here ----
# PRIVY_APP_ID=<your-privy-app-id>   # used by convex/auth.config.ts (must equal the token `aud`)
# HELIUS_WEBHOOK_SECRET=<shared-secret>   # used by convex/http.ts to auth the /helius/webhook callback (E1.3)
# WORKOS_CLIENT_ID=<your-workos-client-id>   # Admin Story 1.1: presence ALONE enables the WorkOS
#   auth provider in convex/auth.config.ts (a second provider alongside Privy). Leave it unset on a
#   consumer-only deployment — the config reads it only when it is present, so nothing breaks.
