# Copy to .env.local and fill in.

# Convex (from `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud

# Privy (from Privy dashboard → App settings)
NEXT_PUBLIC_PRIVY_APP_ID=<your-privy-app-id>

# ---- Set in the CONVEX dashboard (Settings → Environment Variables), NOT here ----
# PRIVY_APP_ID=<your-privy-app-id>   # used by convex/auth.config.ts (must equal the token `aud`)
